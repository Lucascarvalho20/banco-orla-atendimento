# Copie para .env e troque TODOS os valores "troque-..." (o .env nunca vai para o Git).
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=orla
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=orla
# Porta alta para não conflitar com Postgres instalado direto na máquina (5432/5433)
POSTGRES_PORT=55432
DATABASE_URL=postgres://orla:troque-esta-senha@127.0.0.1:55432/orla

# Usuário só-leitura da IA (SELECT apenas nas tabelas kb_*) — criado na Etapa 2
AI_READER_PASSWORD=troque-esta-senha-tambem
# Usuário da ingestão (escreve só na base de conhecimento) — criado na Etapa 5
KB_WRITER_PASSWORD=troque-esta-senha-tambem

# --- AWS emulada (MiniStack, ADR 0012) ---
# Só o emulador local é aceito: os scripts recusam qualquer outro endereço.
# As chaves abaixo são as fixas do emulador, não são credenciais reais (nunca coloque uma aqui).
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
KB_BUCKET=orla-kb

# --- Serviço realtime ---
REALTIME_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Segredos da aplicação ---
# Obrigatórios, sem valor de exemplo de propósito: gere os seus com o comando do topo do arquivo.
# HMAC do CPF (LGPD): perder este valor = não reconhecer sessões antigas
CPF_HMAC_SECRET=
SESSION_SECRET=

# --- IA (Ollama local, grátis) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Perguntas aos documentos (RAG) por conversa; a FAQ não conta
RAG_MAX_PER_CONVERSATION=15

# --- V2 (opcional) ---
# docker compose --profile v2 up -d   # Mongo + Redis
MESSAGE_STORE=postgres
MONGODB_URL=mongodb://127.0.0.1:27017/orla
AGENT_TOOLS_ENABLED=false
# Depois de: pnpm kb:events  (ou terraform apply em infra/terraform)
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:orla-eventos
EVENT_BUS_NAME=orla
# REDIS_URL=redis://127.0.0.1:6379
